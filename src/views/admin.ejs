<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<title>PrismLens | Admin</title>
		<%- include('partials/head') %>
		<link rel="stylesheet" type="text/css" href="/css/setting.css" />
		<link rel="stylesheet" type="text/css" href="/css/admin.css" />
		<link href="/css/datatables.min.css" rel="stylesheet" />
		<script src="/js/datatables.min.js"></script>
	</head>

	<body>
		<%- include('partials/navbar') %>

		<div class="page-content">
			<div class="table-responsive">
				<table id="kt_datatable_zero_configuration" class="table table-row-bordered gy-5">
					<thead>
						<tr class="fw-semibold fs-6 text-muted">
							<th>Username</th>
							<th>Creation Date</th>
							<th>Role</th>
							<th>Delete Account</th>
							<th>Password</th>
							<td>ID</td>
						</tr>
					</thead>
					<tbody>
						<% for( let index = 0; allUsers.length > index; index++ ) { %>
						<tr>
							<td><%= allUsers[index].username %></td>
							<td><%= allUsers[index].dateCreated %></td>
							<td><%= allUsers[index].role %></td>
							<td></td>
							<td>Password</td>
							<td><%= allUsers[index].id %></td>
						</tr>
						<% } %>
					</tbody>
					<tfoot>
						<tr>
							<th>Username</th>
							<th>Creation Date</th>
							<th>Role</th>
							<th>Delete Account</th>
							<th>Password</th>
							<td>ID</td>
						</tr>
					</tfoot>
				</table>
			</div>
		</div>
	</body>

	<dialog id="username">
		<form method="post" action="/api/v1/user/username">
			<div class="dialog-title">Change username of user <br />'<span id="dialog-username-target"></span>'</div>
			<input name="id" class="hidden" id="dialog-username-target-id" />
			<div class="dialog-entry"><input name="Username" placeholder="New username" /></div>
			<div class="horizontal-button">
				<button type="button" onclick="closeDialog()"><span>Abort</span></button>
				<button type="submit"><span>Confirm</span></button>
			</div>
		</form>
	</dialog>

	<dialog id="password">
		<form method="post" action="/api/v1/user/password">
			<div class="dialog-title">Change password of user <br />'<span id="dialog-password-target"></span>'</div>
			<input name="id" class="hidden" id="dialog-password-target-id" />
			<div class="dialog-entry"><input name="password" type="password" placeholder="New password" /></div>
			<div class="dialog-entry"><input name="passwordConfirm" type="password" placeholder="Confirm password" /></div>
			<div class="horizontal-button">
				<button type="button" onclick="closeDialog()"><span>Abort</span></button>
				<button type="submit"><span>Confirm</span></button>
			</div>
		</form>
	</dialog>

	<dialog id="role">
		<form method="post" action="/api/v1/user/role">
			<div class="dialog-title">Change role of user <br />'<span id="dialog-role-target"></span>'</div>
			<input name="id" class="hidden" id="dialog-role-target-id" />
			<div class="dialog-entry">
				<select name="role">
					<option value="user">User</option>
					<option value="moderator">Moderator</option>
					<option value="admin">Admin</option>
				</select>
			</div>
			<div class="horizontal-button">
				<button type="button" onclick="closeDialog()"><span>Abort</span></button>
				<button type="submit"><span>Confirm</span></button>
			</div>
		</form>
	</dialog>

	<dialog id="delete">
		<form method="post" action="/api/v1/user/delete">
			<div class="dialog-title">Delete user <br />'<span id="dialog-delete-target"></span>'?</div>
			<input name="id" class="hidden" id="dialog-delete-target-id" />
			<div class="dialog-entry"></div>
			<div class="horizontal-button">
				<button type="button" onclick="closeDialog()"><span>Abort</span></button>
				<button type="submit"><span>Confirm</span></button>
			</div>
		</form>
	</dialog>

	<script src="/js/admin.js"></script>
</html>
