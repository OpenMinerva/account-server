<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<title>OpenMinerva | Account Server</title>
		<%- include('partials/head') %>
		<link rel="stylesheet" type="text/css" href="/css/theme.css" />
		<link rel="stylesheet" type="text/css" href="/css/account-server.css" />
	</head>

	<body>
		<%- include('partials/navbar') %>

		<div class="container">
			<div class="account-container account-header">
				<div class="account-picture"></div>
				<div class="account-info">
					<div class="account-info-name"><%= targetUser.username %></div>
					<div class="account-info-created"><%= targetUser.dateCreated %></div>
				</div>
			</div>

			<div class="account-container account-biography">
				<div>User biography is not implemented.</div>
			</div>
		</div>

		<%- include('partials/footer') %>
	</body>
</html>
