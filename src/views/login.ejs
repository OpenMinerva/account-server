<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <title>PrismLens | Account Server</title>
    <script src="/js/api.js"></script>
    <%- include('partials/head') %>
</head>

<body>
    <%- include('partials/navbar') %>

        <div class="login-container">
            <div class="logo">
                <img src="/img/logoSmall.webp" alt="PrismLens Logo" />
                <div>PrismLens</div>
            </div>
            <div class="text-entry">
                <div class="title">Username</div>
                <input id="username" type="text" placeholder="Enter your username" />
            </div>
            <div class="text-entry">
                <div class="title">Password</div>
                <input id="password" type="password" placeholder="Enter your password" />
            </div>
            <div class="button-container">
                <button
                    onclick="loginAccount(document.querySelector('#username').value, document.querySelector('#password').value)">Login</button>
                <button type="button" onclick="window.location.href='/signup'">Sign Up</button>
            </div>
        </div>
</body>

</html>